# $DSH_HOME/.env de CidIA. Lo escribe el instalador a partir de esta plantilla.
#
# Aquí NO puede ir ninguna variable DSH_* (la app se niega a arrancar): esas las fija el
# lanzador CidIA.exe en su propio entorno.
#
# Dirección del servidor CidIA de la empresa (para cambiar de servidor, edita estas tres
# líneas y reinicia CidIA).
CIDIA_GATEWAY_URL={{GATEWAY_URL}}
CIDIA_LLM_URL={{GATEWAY_URL}}/v1
CIDIA_MCP_URL={{GATEWAY_URL}}/mcp
#
# Token de arranque. Hace que la app no muestre la bienvenida de DeepSeek (pide una clave si
# ningún proveedor tiene credencial). No da acceso a nada: al arrancar, el plugin CidIA pide un
# token de invitado al servidor y, cuando la persona inicia sesión, usa el suyo.
CIDIA_GATEWAY_TOKEN=arranque-sin-sesion
