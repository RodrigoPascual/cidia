# Perfil del servidor de pruebas Oracle (ARM, sin GPU). Sin secretos: van en secretos/cidia.env.
CIDIA_ENTORNO=desarrollo
CIDIA_NOMBRE_SERVIDOR=Servidor de pruebas (Oracle ARM)
CIDIA_LLM_MODELO_CHAT=qwen3:0.6b
CIDIA_LLM_MODELO_EMBEDDINGS=qwen3-embedding:0.6b
CIDIA_LLM_MODELO_VISION=qwen3.5:0.8b
CIDIA_LLM_TIMEOUT=600
CIDIA_ASR_MODELO=base
CIDIA_MOTOR_CONOCIMIENTO=pgvector
CIDIA_UMBRAL_RESPALDO=0.40
CIDIA_CREAR_SEMILLA=true
CIDIA_INVITADO_LIMITE_HORA=60
