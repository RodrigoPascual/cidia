# Perfil genérico de CidIA: plantilla para cualquier PC o servidor de empresa. Sin secretos.
#
# instalar-servidor.sh la copia como perfiles/generico.env (fichero local de cada instalación,
# fuera de git) y ajusta los modelos a la memoria del equipo y la dirección pública. Para un
# perfil a medida (por ejemplo, un servidor con una GPU grande), copia este fichero como
# perfiles/<nombre>.env, cambia los modelos y ejecuta el instalador con --perfil <nombre>.
#
# Los secretos y los recursos de los contenedores (memoria, CPU, contexto de Ollama, modelo de
# voz) van en <instalación>/secretos/cidia.env, no aquí.

CIDIA_ENTORNO=produccion
CIDIA_NOMBRE_SERVIDOR=Servidor CidIA
# Dirección con la que se identifica el servidor en el registro de actividad (xAPI).
CIDIA_URL_PUBLICA=http://127.0.0.1:18700

# Modelos locales (Ollama), todos con licencia Apache-2.0. En el procesador, ministral-3:3b
# responde con visión y herramientas; con menos de 16 GB de RAM el instalador pone qwen3:1.7b
# (chat) y qwen3.5:0.8b (visión). Los embeddings son los mismos que en el MSI, así que las
# colecciones no cambian si luego se pasa a un equipo con GPU.
CIDIA_LLM_MODELO_CHAT=ministral-3:3b
CIDIA_LLM_MODELO_EMBEDDINGS=qwen3-embedding:0.6b
CIDIA_LLM_MODELO_VISION=ministral-3:3b
CIDIA_LLM_TIMEOUT=600

# Voz: el modelo que carga el servicio lo fija ASR_MODELO en cidia.env (base o small).
CIDIA_ASR_MODELO=small

CIDIA_MOTOR_CONOCIMIENTO=pgvector
CIDIA_UMBRAL_RESPALDO=0.40
CIDIA_CREAR_SEMILLA=false
CIDIA_INVITADO_LIMITE_HORA=30
